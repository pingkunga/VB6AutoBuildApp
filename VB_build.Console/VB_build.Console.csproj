<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>VB_build</RootNamespace>
    <AssemblyName>VB_build</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- VB6.EXE / TLI automation are 32-bit only; keep this process x86. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VB_build.Core\VB_build.Core.csproj" />
  </ItemGroup>

</Project>
